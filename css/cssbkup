/* ==================================================
   RESET & BASE
================================================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: #306f1b;
}

/* ==================================================
   HEADER & LOGO
================================================== */
.header {
  text-align: center;
  padding: 20px 20px 10px;
}
.header {
  position: relative;
  z-index: 10;
}

.logo-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

.logo-container h1 {
  font-size: 2.5rem;
  font-weight: 300;
}

.logo-img {
  max-width: 250px;
  height: auto;
}

@media (max-width: 768px) {
  .logo-img {
    max-width: 180px;
  }
}

/* ==================================================
   NAVIGATION
================================================== */
.nav {
  margin-top: 0px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
}
.nav {
  position: relative;
}
.menu-toggle {
  display: none;
}


.menu {
  list-style: none;
  display: flex;
  gap: 25px;
}

.menu a {
  text-decoration: none;
  color: #306f1b;
  font-weight: 600;
  padding: 10px 18px;
  transition: background-color 0.25s ease, color 0.25s ease;
}

.menu a:hover,
.menu a.active {
  background-color: #306f1b;
  color: #ffffff;
}

/* ==================================================
   LANGUAGE SELECTOR (FIXED GLOBAL)
================================================== */
.language-selector {
  position: fixed;
  bottom: 30px;
  right: 20px;
  z-index: 5000;

  display: flex;
  justify-content: center;
}

/* Botón */
.lang-btn {
  display: flex;
  align-items: center;
  gap: 8px;              /* menos separación interna */
  padding: 12px 12px;    /* menos margen lateral */
  border: 1px solid #ddd;
  background: #fff;
  cursor: pointer;
  border-radius: 6px;
  font-size: 15px;
  font-weight: 600;
}


/* Flags */
.lang-btn img,
.lang-dropdown img {
  width: 28px;           /* mejor proporción con el botón */
  height: auto;
}


/* Dropdown */
.lang-dropdown {
  list-style: none;
  position: absolute;

  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);

  width: 160px;          /* un poco más ancho */
  background: #fff;
  border: 1px solid #ddd;
  display: none;
  z-index: 10;
  border-radius: 6px;
}


.lang-dropdown li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;    /* área táctil cómoda */
  cursor: pointer;
  font-size: 15px;       /* consistente con botón */
}

/* ==================================================
   HOME – HERO SECTION
================================================== */

.home-hero {
  height: 520px;
  background: url("../images/BgRedesSociales.jpg") center right / cover no-repeat;
  display: flex;
  align-items: center;
}

.home-hero-content {
  max-width: 600px;
  padding-left: 120px;
}

.home-hero-content h1 {
  font-size: 2.5rem;
  font-weight: 700;
  color: #306f1b;
  letter-spacing: 1px;
  line-height: 1.15;
  margin-bottom: 25px;
}

.home-hero-content p {
  font-size: 1.4rem;
  line-height: 1.6;
  color: #306f1b;
}

/* ==================================================
   HOME – ABOUT SECTION
================================================== */

.home-about {
  padding: 100px 20px 120px;
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
}

.home-about h2 {
  font-size: 2.8rem;
  font-weight: 700;
  color: #306f1b;
  margin-bottom: 35px;
  letter-spacing: 1px;
}

.home-about-text {
  font-size: 1rem;
  line-height: 1.9;
  color: #306f1b;
  margin-bottom: 35px;
}

.home-about-highlight {
  font-size: 1.2rem;
  font-weight: 600;
  color: #306f1b;
}

/* ==================================================
   HOME RESPONSIVE
================================================== */

@media (max-width: 900px) {
  .home-hero {
    height: auto;
    padding: 80px 20px;
    background-position: center;
  }

  .home-hero-content {
    padding-left: 0;
    text-align: center;
    max-width: 100%;
  }

  .home-hero-content h1 {
    font-size: 2.4rem;
  }

  .home-hero-content p {
    font-size: 1.2rem;
  }
}

/* ==================================================
   CONTACT SECTION
================================================== */
.contact-section {
  font-family: 'Montserrat', sans-serif;
}

/* --- TOP (COLOR BLOCK) --- */
.contact-main {
  padding: 50px 10%;
  color: #ffffff;

  /* IMAGEN COMO FONDO PRINCIPAL */
  background-image: url("../images/banner.png");
  background-repeat: repeat;
  background-position: center;
  background-size: auto;
}
.contact-title {
  text-align: center;
  font-size: 36px;
  letter-spacing: 2px;
  margin-bottom: 60px;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  align-items: start;
  gap: 40px;
}

.contact-item h3,
.contact-item p {
  text-align: center;
}
.contact-item h3 {
  font-size: 18px;
  margin-bottom: 20px;
}

.contact-item p {
  font-size: 16px;
  line-height: 1.6;
}

/* DIVIDERS */
.divider {
  width: 2px;
  background-color: rgba(255, 255, 255, 0.6);
  align-self: stretch;
}

/* --- BOTTOM (WHITE BLOCK) --- */
.contact-footer {
  background-color: #ffffff;
  padding: 50px 10%;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
}

.footer-inner img {
  max-width: 240px;
}

.footer-text p {
  font-size: 15px;
  margin: 4px 0;
  color: #306f1b;
}

/* ==================================================
   CONTACT RESPONSIVE
================================================== */
@media (max-width: 900px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .divider {
    display: none;
  }

  .footer-inner {
    flex-direction: column;
    text-align: center;
  }
}

/* ==================================================
   ABOUT PAGE
================================================== */
.about-hero {
  height: 220px;
  background: url("../images/BgRedesSociales.jpg") center / cover no-repeat;
  position: relative;
}

.about-hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fff;
  text-align: center;
}

.about-hero-overlay h1 {
  font-size: 2.8rem;
  letter-spacing: 2px;
}

.about-main {
  padding: 120px 20px;
}

.about-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 80px;
}

.about-text h2,
.about-text p {
  color: #306f1b;
}

.about-text p {
  line-height: 1.8;
}
/* ================= ABOUT EXTRA CONTENT ================= */

.about-centered-text {
  max-width: 800px;
  margin: 80px auto 60px;
  text-align: center;
  font-size: 1.1rem;
  line-height: 1.8;
  color: #306f1b;
}

/* === TWO IMAGES SECTION === */

.about-images {
  padding: 40px 20px 80px;
}

.about-images-grid {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
}

.about-image-item img {
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.about-image-item p {
  margin-top: 15px;
  text-align: center;
  font-size: 0.95rem;
  color: #306f1b;
}
.team-title {
  text-align: center;
  margin: 0px 0px;
}
/* === PROCESS TITLE === */

.process-title {
  text-align: center;
  margin: 0px 0px;
}

.process-title h2 {
  font-size: 2.4rem;
  color: #306f1b;
}

/* === RESPONSIVE === */
@media (max-width: 900px) {
  .about-images-grid {
    grid-template-columns: 1fr;
  }

  .about-image-item img {
    height: 240px;
  }
}


/* ==================================================
   HOME HERO
================================================== */
.home-hero {
  height: 520px;
  background: url("../images/BgRedesSociales.jpg") center right / cover no-repeat;
  display: flex;
  align-items: center;
}

.home-hero-content {
  max-width: 600px;
  padding-left: 120px;
}

.home-hero-content h1,
.home-hero-content p {
  margin-left: 40px;
}

/* ================= ACCORDION ================= */
.process {
  padding: 30px 20px;
}

.process-container {
  max-width: 1000px;
  margin: 0 auto;
  border: 1px solid #d8dee3;
}

.accordion-item {
  border-bottom: 1px solid #d8dee3;
}

.accordion-header {
  width: 100%;
  background: #fff;
  border: none;
  padding: 22px 30px;
  display: flex;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  font-size: 1.1rem;
  font-weight: 600;
  color: #306f1b;
  text-align: left;
}

.icon {
  width: 22px;
  font-size: 1.6rem;
  line-height: 1;
}

.accordion-content {
  display: none;
  padding: 0 30px 25px 68px;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #306f1b;
}

.accordion-item.open .accordion-content {
  display: block;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 768px) {
  .accordion-header {
    padding: 18px 20px;
  }

  .accordion-content {
    padding-left: 55px;
  }
}
/* ==================================================
   GLOBAL RESPONSIVE
================================================== */
@media (max-width: 900px) {
  .home-hero {
    height: auto;
    padding: 80px 20px;
  }

  .home-hero-content {
    padding-left: 0;
    text-align: center;
  }
}
/* ================= GALLERY GRID ================= */

.gallery-section {
    padding: 80px 40px;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.gallery-item {
    width: 100%;
    height: 220px;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.gallery-item:hover {
    transform: scale(1.03);
}

/* ================= LIGHTBOX ================= */

.lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 999;
}

.lightbox img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
}

/* CLOSE */
.lightbox-close {
    position: absolute;
    top: 30px;
    right: 40px;
    font-size: 40px;
    color: #fff;
    cursor: pointer;
}

/* ARROWS */
.lightbox-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 60px;
    color: #fff;
    cursor: pointer;
    user-select: none;
}

.lightbox-arrow.left {
    left: 40px;
}

.lightbox-arrow.right {
    right: 40px;
}
.gallery-section {
    padding: 80px 80px; /* arriba/abajo | izquierda/derecha */
}
/* RESPONSIVE */
@media (max-width: 900px) {
    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .gallery-item {
        height: 180px;
    }
}
/* ================= NATURAL COLORS SECTION ================= */

.colors-section {
    position: relative;
    padding: 120px 20px 100px;
    background: 
        linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.25)),
        url("../images/b1.jpeg") center / cover no-repeat;
    text-align: center;
}

.colors-title {
    font-size: 2.8rem;
    color: #ffffff;
    margin-bottom: 80px;
    letter-spacing: 1px;
}

/* GRID */
.colors-grid {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
}

/* CARD */
.color-card {
    background: #ffffff;
    border-radius: 7px;   /* ajusta a gusto: 12–20px */
    padding: 25px 20px 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.color-card img {
    width: 100%;
    height: 260px;
    object-fit: contain;
    margin-bottom: 20px;
}

.color-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1b5e6f;
    line-height: 1.4;
    margin-bottom: 10px;
}


/* RESPONSIVE */
@media (max-width: 1000px) {
    .colors-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .colors-grid {
        grid-template-columns: 1fr;
    }

    .colors-title {
        font-size: 2.2rem;
    }
}
/* =================Menu desplegable ================= */

.menu-toggle {
  display: none;
  font-size: 2rem;
  cursor: pointer;
  list-style: none;
  background: none;
  border: none;
  color: #306f1b;
}

/* Ocultar flecha por defecto del summary */
.menu-toggle::-webkit-details-marker {
  display: none;
}
/* ==================================================
   MENU – BASE (DESKTOP)
================================================== */

.menu-desktop {
  display: flex;
}

.menu-mobile {
  display: none;
}

.mobile-nav {
  display: none;
}

.menu-toggle {
  display: none;
}

/* ==================================================
   NAV – MOBILE STRUCTURE
================================================== */

.mobile-nav .menu {
  display: none;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-top: 1px solid #ddd;
  margin-top: 10px;
}

.mobile-nav[open] .menu {
  display: flex;
}

.menu li {
  border-bottom: 1px solid #eee;
}

.menu a {
  padding: 15px;
  display: block;
  text-align: center;
}

/* ==================================================
   LANGUAGE SELECTOR – GLOBAL
================================================== */

.language-selector {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 5000;
  display: flex;
  justify-content: center;
}

.lang-dropdown {
  position: absolute;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
}

/* ==================================================
   PRODUCT GRID (CLICKABLE)
================================================== */


.product-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.color-card {
  transition: transform 0.2s ease;
}

.product-link:hover .color-card {
  transform: translateY(-4px);
}

/* ==================================================
   PRODUCT PAGE – DESKTOP
================================================== */

.product-page {
  max-width: 1200px;
  margin: 60px auto;
  padding: 0 20px;
  margin-top: 0;
  padding-top: 16px; /* o 0 si lo quieres totalmente pegado */
}

.product-page h1 {
  text-align: center;
  font-size: 28px;
  letter-spacing: 2px;
  margin-bottom: 50px;
}
.product-specs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;                /* menos espacio entre celdas */
  margin: 24px 0;
}

.product-specs div {
  padding: 14px 10px;       /* ⬅️ reduce tamaño de caja */
  border: 1px solid #ddd;
  text-align: center;
}
.product-specs span {
  font-size: 13px;
}

.product-specs strong {
  font-size: 14px;
  color: #2f6f3e;
}

/* GRID PRINCIPAL */
.product-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}

/* IMAGE */
.product-image {
  display: flex;
  justify-content: center;
}

#productTitle {
  margin: 0;                 /* quita todo el margen */
  margin-bottom: 24px;       /* solo un pequeño respiro abajo */
  color: #2f6f3e;            /* verde característico */
  font-weight: 700;
}


.product-image img {
  max-width: 100%;
  height: auto;
  max-width: 420px;     /* ⬅️ ajusta este valor */
  margin: 0 auto;
}

/* INFO */
.product-info {
  border: 1px solid #ddd;
  padding: 30px;
}

/* ==================================================
   SELECTOR
================================================== */

.product-selector {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 30px;
}

.product-selector button {
  background: #fff;
  border: 1px solid #ccc;
  padding: 12px 8px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.product-selector button:hover {
  background: #f5f5f5;
}

.product-selector button.active {
  border-color: #000;
  font-weight: 600;
}

/* ==================================================
   SPECS TABLE
================================================== */

.product-specs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid #ddd;
  margin-bottom: 40px;
}

.product-specs div {
  text-align: center;
  padding: 20px 10px;
  border-right: 1px solid #ddd;
}

.product-specs div:last-child {
  border-right: none;
}

.product-specs span {
  display: block;
  font-size: 13px;
  color: #777;
  margin-bottom: 6px;
}

.product-specs strong {
  font-size: 14px;
  font-weight: 600;
}

/* ==================================================
   SECOND IMAGE / DETAIL
================================================== */

.product-detail-image {
  display: flex;
  justify-content: center;
  margin-bottom: 40px;
}

.product-detail-image img {
  max-width: 160px;
}

/* ==================================================
   BUTTON
================================================== */

.contact-btn {
  display: inline-block;
  background: #4c6f91;
  color: #fff;
  border: none;
  padding: 14px 26px;
  border-radius: 30px;
  font-size: 14px;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.3s ease;
}

.contact-btn:hover {
  background: #3b5873;
}

/* ==================================================
   MOBILE (≤ 900px)
================================================== */

@media (max-width: 900px) {

  /* NAV */
  .menu-desktop {
    display: none;
  }

  .mobile-nav {
    display: block;
    width: 100%;
  }

  .menu-mobile {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-top: 1px solid #ddd;
  }

  .menu-toggle {
    display: block;
    font-size: 2rem;
    cursor: pointer;
    margin-left: auto;
    margin-right: 10px;
  }

  .menu-toggle::-webkit-details-marker {
    display: none;
  }

  .nav {
    position: relative;
  }

  /* LANGUAGE SELECTOR */
  .language-selector {
    bottom: 20px;
    right: 20px;
  }

  /* PRODUCT PAGE */
  .product-layout {
    grid-template-columns: 1fr;
  }

  .product-info {
    padding: 20px;
  }

  .product-specs {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-specs div:nth-child(2) {
    border-right: none;
  }
}
/* =========================
   FIX PRODUCT DETAILS PAGE
========================= */

.product-page {
  display: block;
  font-family: inherit;
}

.product-page * {
  box-sizing: border-box;
}
.see-more {
  margin-top: 10px;
  font-size: 14px;
  color: #4c6f91;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  text-align: center;
}

/* efecto hover */
.product-link:hover .see-more {
  text-decoration: underline;
}
.color-card img {
  width: 100%;
  height: 220px;          /* AJUSTA ESTE VALOR */
  object-fit: cover;     /* CLAVE */
  display: block;
}
/* ==================================================
   PRODUCT GRID – FIX DEFINITIVO
================================================== */

/* Reset completo del link */
.product-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

/* Quita subrayado en TODOS los estados */
.product-link:link,
.product-link:visited,
.product-link:hover,
.product-link:active {
  text-decoration: none;
  color: inherit;
}

/* Card base */
.color-card {
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* Hover REAL (desde el <a>) */
.product-link:hover .color-card {
  transform: translateY(-6px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

/* Imagen consistente */
.color-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}
/* ==================================================
   FIX LINK STATES (visited / focus)
================================================== */

/* Reset total del <a> en TODOS los estados */
.product-link,
.product-link:link,
.product-link:visited,
.product-link:hover,
.product-link:active,
.product-link:focus {
  text-decoration: none;
  color: inherit;
  outline: none;
}

/* Accesibilidad: focus solo visible con teclado */
.product-link:focus-visible .color-card {
  outline: 2px solid #4c6f91;
  outline-offset: 4px;
}

/* =========================
   RELATED PRODUCTS
========================= */

.related-products {
  margin: 80px auto;
  max-width: 1200px;
  padding: 0 20px;
}

.related-products h2 {
  text-align: left;
  margin-left: 40px;
  margin-bottom: 40px;
}
.related-products .colors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  justify-content: center;   /* centra la grid */
  gap: 32px;
  max-width: 1100px;         /* controla el ancho */
  margin: 0 auto;            /* centra horizontal */
}
.related-products .color-card {
  border-radius: 7px;
  overflow: hidden;          /* para que la imagen respete el borde */
}

.color-card img {
  width: 100%;
  height: 220px;          /* controla el área de imagen */
  object-fit: contain;   /* no recorta, no deforma */
  display: block;
}

.related-products .colors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 25px;
  max-width: 900px;
  margin: 0 auto;
}

.related-products .color-card {
  max-width: 240px;
}


.related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
  text-align: center;
}

.related-card img {
  width: 100%;
  max-width: 220px;
  margin: 0 auto 20px;
  display: block;
}

.related-card h3 {
  font-size: 16px;
  margin-bottom: 16px;
}

.related-card a {
  display: inline-block;
  background: #4c6f91;
  color: #fff;
  padding: 10px 26px;
  border-radius: 30px;
  font-size: 13px;
  text-decoration: none;
  transition: background 0.2s ease;
}

.related-card a:hover {
  background: #3b5873;
}

/* Responsive */
@media (max-width: 900px) {
  .related-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.product-page h1 {
  font-size: 32px;
  font-weight: 600;
  color: #000;
  margin-bottom: 40px;
  display: block;
  opacity: 1;
  visibility: visible;
}
